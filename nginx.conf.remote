events {
	worker_connections 1024;
}

http {

	 large_client_header_buffers 4 10M;
        client_max_body_size 10M;

    server {
            server_name zakupy.piekoszek.pl;
    

	
	    location / {
          proxy_pass http://localhost:2106;
    
	 
	  proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_set_header Authorization $http_authorization;

	    }


    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/patrycja-marczak.pl/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/patrycja-marczak.pl/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot



}

    server {
	include mime.types;
	server_name parkowanie.piekoszek.pl;

	large_client_header_buffers 4 10M;
        client_max_body_size 10M;

	root /www/parkowanie/static;
	location / {
		index index.html;
	}
    
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/patrycja-marczak.pl/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/patrycja-marczak.pl/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}


    server {
	include mime.types;
	server_name patrycja-marczak.pl;

	large_client_header_buffers 4 10M;
        client_max_body_size 10M;

	root /www/marczak/static;
	location / {
		index index.html;
	}
    
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/patrycja-marczak.pl/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/patrycja-marczak.pl/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot



}



    server {
    server_name www.patrycja-marczak.pl;
    return 301 https://patrycja-marczak.pl$request_uri;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/patrycja-marczak.pl/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/patrycja-marczak.pl/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

    if ($host = patrycja-marczak.pl) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


	listen 80;
	server_name patrycja-marczak.pl;
    return 404; # managed by Certbot


}

    server {
    if ($host = www.patrycja-marczak.pl) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name www.patrycja-marczak.pl;
    return 404; # managed by Certbot


}

    server {
    if ($host = zakupy.piekoszek.pl) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


            listen 80;
            server_name zakupy.piekoszek.pl;
    return 404; # managed by Certbot


}



    server {
    if ($host = parkowanie.piekoszek.pl) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


	listen 80;
	server_name parkowanie.piekoszek.pl;
    return 404; # managed by Certbot

}


    server {
        listen 80;
        server_name piekoszek.pl;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl http2;
        server_name piekoszek.pl;

        ssl_certificate         /etc/letsencrypt/live/piekoszek.pl/fullchain.pem;
        ssl_certificate_key     /etc/letsencrypt/live/piekoszek.pl/privkey.pem;
        ssl_protocols           TLSv1.2 TLSv1.3;
        ssl_ciphers             HIGH:!aNULL:!MD5;

        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;

        location / {
            proxy_pass         http://127.0.0.1:8080;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }
    }

    server {
        listen 80;
        server_name prompter.piekoszek.pl;

        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        location / {
            proxy_pass         http://127.0.0.1:8081;
            proxy_set_header   Host $host;
            proxy_set_header   X-Real-IP $remote_addr;
            proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header   X-Forwarded-Proto $scheme;
        }
    }

}
